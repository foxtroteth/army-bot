<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd LaunchAgent template for ArmyBot.
  __HOME__ is replaced with your home directory at install time (see DEPLOY.md).
  No secrets here: DISCORD_TOKEN is read from ~/army-bot/.env by bot.py.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.apex.army-bot</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/army-bot/.venv/bin/python</string>
		<string>bot.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__HOME__/army-bot</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/army-bot/logs/stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/army-bot/logs/stderr.log</string>
</dict>
</plist>
